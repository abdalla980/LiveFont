---
const { title, description } = Astro.props;
const storeUrl = 'https://chromewebstore.google.com/detail/ahdfmlobklcldcjfapjpnhdmdncdenhj?utm_source=item-share-cb';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js-enabled');</script>
  <!-- Google Analytics 4 (Consent Mode v2 — loads after Accept in EU) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 500,
    });
    gtag('js', new Date());
    gtag('config', 'G-PNMEYZXLL9', { send_page_view: true });
  </script>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PNMEYZXLL9"></script>
  <style is:global>
    :root {
      --silver-0: #f7f8fa;
      --silver-1: #eef0f4;
      --silver-2: #dde1e8;
      --silver-3: #c5cad3;
      --silver-4: #9aa3b0;
      --ink: #2a2f3a;
      --ink-soft: #5c6575;
      --plum: #4a3568;
      --mustard: #c4a035;
      --lemon: #e8c84a;
      --card: rgba(255, 255, 255, 0.55);
      --card-border: rgba(255, 255, 255, 0.75);
      --border: rgba(42, 47, 58, 0.1);
      --font: 'Poppins', system-ui, sans-serif;
      --radius: 18px;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    html, body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      color: var(--ink);
      font-family: var(--font);
      font-weight: 300;
      -webkit-font-smoothing: antialiased;
      background-color: var(--silver-1);
      background-image:
        linear-gradient(125deg, rgba(255,255,255,0.85) 0%, transparent 42%),
        linear-gradient(305deg, rgba(197,202,211,0.55) 0%, transparent 48%),
        radial-gradient(ellipse 90% 60% at 50% -20%, #ffffff 0%, transparent 55%),
        linear-gradient(180deg, var(--silver-0) 0%, var(--silver-1) 35%, var(--silver-2) 100%);
      background-attachment: fixed;
    }

    h1, h2, h3 {
      font-family: var(--font);
      font-weight: 500;
      letter-spacing: -0.03em;
      color: var(--ink);
      margin: 0;
    }

    a { color: inherit; }

    .wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .eyebrow {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--plum);
      margin: 0 0 12px;
    }

    .cta-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 28px;
      border-radius: 999px;
      background: linear-gradient(145deg, #3d334f 0%, var(--plum) 100%);
      color: #fff8e8;
      font-family: var(--font);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      border: 1px solid rgba(255,255,255,0.12);
      cursor: pointer;
      box-shadow: 0 10px 28px rgba(74, 53, 104, 0.22);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .cta-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 34px rgba(74, 53, 104, 0.3);
    }

    .cta-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .cta-primary { transition: none; }
    }
  </style>
  <style>
    header.site {
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(16px) saturate(1.2);
      background: rgba(247, 248, 250, 0.72);
      border-bottom: 1px solid rgba(255,255,255,0.5);
      box-shadow: 0 1px 0 rgba(42, 47, 58, 0.06);
    }
    header.site .wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
      gap: 24px;
    }
    .brand {
      font-weight: 500;
      font-size: 20px;
      letter-spacing: -0.04em;
      text-decoration: none;
      color: var(--ink);
    }
    .brand span { color: var(--plum); font-weight: 400; }
    .site-nav {
      display: flex;
      align-items: center;
      gap: 22px;
    }
    .site-nav a {
      color: var(--ink-soft);
      text-decoration: none;
      font-size: 13px;
      font-weight: 400;
    }
    .site-nav a:hover { color: var(--ink); }
    .site-nav .nav-cta {
      padding: 8px 16px;
      border-radius: 999px;
      background: var(--ink);
      color: #f5f6f8;
      font-weight: 500;
      box-shadow: none;
    }
    .site-nav .nav-cta:hover {
      color: #fff;
      transform: none;
      box-shadow: none;
    }
    @media (max-width: 640px) {
      .site-nav a:not(.nav-cta) { display: none; }
    }
    footer.site {
      margin-top: 8px;
      border-top: 1px solid var(--border);
      background: rgba(221, 225, 232, 0.45);
    }
    footer.site .wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 72px;
      flex-wrap: wrap;
      gap: 12px;
      padding-top: 20px;
      padding-bottom: 20px;
    }
    footer.site nav { display: flex; gap: 20px; }
    footer.site a {
      color: var(--ink-soft);
      text-decoration: none;
      font-size: 13px;
      font-weight: 400;
    }
    footer.site a:hover { color: var(--ink); }
    footer.site .copy {
      color: var(--ink-soft);
      font-size: 13px;
    }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/">Live<span>Font</span>y</a>
      <nav class="site-nav">
        <a href="/#features">Features</a>
        <a href="/#how-it-works">How it works</a>
        <a href="/#faq">FAQ</a>
        <a class="nav-cta" href={storeUrl} target="_blank" rel="noopener" data-ga="download" data-ga-place="nav">Download</a>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site">
    <div class="wrap">
      <span class="copy">&copy; 2026 LiveFonty</span>
      <nav>
        <a href="/privacy">Privacy Policy</a>
        <a href="mailto:abdullahizzldin1@gmail.com">Contact</a>
      </nav>
    </div>
  </footer>

  <div id="cookie-banner" class="cookie-banner" hidden>
    <p>
      We use Google Analytics to understand how the site is used (page views and button clicks).
      The Chrome extension itself does not track you.
      <a href="/privacy">Privacy Policy</a>
    </p>
    <div class="cookie-actions">
      <button type="button" id="cookie-reject" class="cookie-btn ghost">Reject</button>
      <button type="button" id="cookie-accept" class="cookie-btn">Accept</button>
    </div>
  </div>

  <style>
    .cookie-banner {
      position: fixed;
      left: 16px;
      right: 16px;
      bottom: 16px;
      z-index: 100;
      max-width: 560px;
      margin: 0 auto;
      padding: 16px 18px;
      border-radius: 14px;
      background: rgba(42, 47, 58, 0.96);
      color: #f5f6f8;
      box-shadow: 0 16px 40px rgba(0,0,0,0.2);
      font-size: 13px;
      line-height: 1.5;
      font-weight: 300;
    }
    .cookie-banner p { margin: 0 0 12px; }
    .cookie-banner a { color: #e8c84a; }
    .cookie-actions { display: flex; gap: 8px; justify-content: flex-end; }
    .cookie-btn {
      border: none;
      border-radius: 999px;
      padding: 8px 14px;
      font: inherit;
      font-weight: 500;
      cursor: pointer;
      background: #e8c84a;
      color: #2a2f3a;
    }
    .cookie-btn.ghost {
      background: transparent;
      color: #f5f6f8;
      border: 1px solid rgba(255,255,255,0.25);
    }
  </style>

  <script is:inline>
    (function () {
      var KEY = 'lf_ga_consent';
      var banner = document.getElementById('cookie-banner');
      var saved = localStorage.getItem(KEY);

      function grant() {
        if (typeof gtag !== 'function') return;
        gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }

      function deny() {
        if (typeof gtag !== 'function') return;
        gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }

      if (saved === 'granted') {
        grant();
      } else if (saved === 'denied') {
        deny();
      } else if (banner) {
        banner.hidden = false;
      }

      document.getElementById('cookie-accept')?.addEventListener('click', function () {
        localStorage.setItem(KEY, 'granted');
        grant();
        if (banner) banner.hidden = true;
      });
      document.getElementById('cookie-reject')?.addEventListener('click', function () {
        localStorage.setItem(KEY, 'denied');
        deny();
        if (banner) banner.hidden = true;
      });

      document.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-ga]') : null;
        if (!el || typeof gtag !== 'function') return;
        gtag('event', el.getAttribute('data-ga') || 'click', {
          event_category: 'engagement',
          event_label: el.getAttribute('data-ga-place') || undefined,
          link_url: el.href || undefined,
        });
      });
    })();
  </script>
</body>
</html>
