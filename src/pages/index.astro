      cursor: pointer;
      font-weight: 400;
      font-size: 15px;
      color: var(--ink);
      list-style: none;
      padding: 14px 0 8px;
    }

    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary:hover { color: var(--plum); }

    .faq-item .chevron {
      flex: none;
      width: 9px;
      height: 9px;
      border-right: 2px solid var(--mustard);
      border-bottom: 2px solid var(--mustard);
      transform: rotate(45deg);
      transition: transform 0.2s ease;
    }

    .faq-item[open] .chevron { transform: rotate(-135deg); }

    .faq-item p {
      margin: 0 0 6px;
      font-size: 14px;
      line-height: 1.65;
      font-weight: 300;
      color: var(--ink-soft);
