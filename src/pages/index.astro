---
import Layout from '../layouts/Layout.astro';

const storeUrl = 'https://chromewebstore.google.com/detail/ahdfmlobklcldcjfapjpnhdmdncdenhj?utm_source=item-share-cb';

const features = [
  {
    title: 'Search all fonts',
    body: 'Filter 1,900+ Google Font families and apply any of them to the page you’re viewing in one click.',
  },
  {
    title: 'Brand vibe picker',
    body: 'Pick a personality — Modern, Bold, Elegant, and more — and get a curated shortlist that fits.',
  },
  {
    title: 'Top 10, real data',
    body: 'A quick-pick list of the 10 most popular fonts, ranked from Google Fonts’ own popularity data.',
  },
];

const audience = [
  {
    title: 'Designers',
    body: 'Pressure-test brand fonts against real content before it ships.',
  },
  {
    title: 'Frontend developers',
    body: 'Try pairings on the live page instead of editing CSS and reloading.',
  },
  {
    title: 'Creative artists',
    body: 'See how fonts shape mood and voice before committing to a direction.',
  },
];

const steps = [
  {
    title: 'Open the popup',
    body: "Click the LiveFonty icon on any page you're viewing.",
  },
  {
    title: 'Search or pick a vibe',
    body: 'Filter 1,900+ fonts, browse by brand personality, or grab a Top 10 pick.',
  },
  {
    title: 'See it instantly',
    body: 'The page updates live in your browser — nothing saved, nothing sent anywhere.',
  },
];

const faqs = [
  {
    q: 'Is LiveFonty free?',
    a: 'Yes. LiveFonty is completely free to install and use, with no signup required.',
  },
  {
    q: 'Does it change my actual website, or just what I see?',
    a: "Only what you see. LiveFonty applies fonts entirely in your browser — it never touches a site's code, files, or database.",
  },
  {
    q: 'Which fonts can I use?',
    a: 'The full Google Fonts catalog — 1,900+ families — searchable, plus a curated Top 10 and picks by brand vibe.',
  },
  {
    q: 'Does LiveFonty collect any of my data?',
    a: 'No. LiveFonty has no analytics, tracking, or data collection of any kind. See the full privacy policy for details.',
  },
  {
    q: 'Which browsers are supported?',
    a: 'Chrome today, via the Chrome Web Store. Support for other Chromium-based browsers may follow.',
  },
  {
    q: 'Who is LiveFonty for?',
    a: 'Designers, frontend developers, and anyone making creative or branding decisions who wants to test typography in seconds.',
  },
];

const marqueeFonts = ['Inter', 'Playfair', 'Space Grotesk', 'Cormorant', 'DM Sans', 'Libre Baskerville', 'Syne', 'Fraunces'];
---
<Layout title="LiveFonty — Live-preview Google Fonts on any website" description="Instantly preview any Google Font on the page you're viewing. Search 1,900+ fonts, browse by brand vibe, or pick from a real-data Top 10.">
  <main>
    <section class="hero">
      <div class="hero-sheen" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow hero-anim">Chrome extension</p>
          <p class="brand-hero hero-anim">LiveFonty</p>
          <h1 class="hero-anim">Preview fonts on the real page — before you commit.</h1>
          <p class="lead hero-anim">
            Drop any Google Font onto the site you’re viewing. No code, no reload, no guesswork.
          </p>
          <div class="cta-row hero-anim">
            <a class="cta-primary" href={storeUrl} target="_blank" rel="noopener" data-ga="download" data-ga-place="hero">Download for Chrome</a>
          </div>
        </div>

        <div class="hero-lab hero-anim" aria-hidden="true">
          <div class="lab-chrome">
            <span class="lab-dot"></span>
            <span class="lab-dot"></span>
            <span class="lab-dot"></span>
            <span class="lab-title">Live preview</span>
          </div>
          <div class="lab-stage">
            <p class="lab-label" id="lab-font-name">Playfair Display</p>
            <p class="lab-sample" id="lab-sample">Fonts, tested in place.</p>
            <div class="lab-bar">
              <span class="lab-pill">Weight 500</span>
              <span class="lab-pill">Live tab</span>
            </div>
          </div>
        </div>
      </div>

      <div class="marquee hero-anim" aria-hidden="true">
        <div class="marquee-track">
          {[...marqueeFonts, ...marqueeFonts].map((name) => (
            <span>{name}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="section audience" data-animate>
      <div class="wrap">
        <p class="eyebrow">Who it's for</p>
        <h2>Built for people who obsess over fonts.</h2>
        <div class="card-grid">
          {audience.map((a) => (
            <article class="glass-card" data-animate-child>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="features" class="section" data-animate>
      <div class="wrap">
        <p class="eyebrow">Features</p>
        <h2>Everything you need to try a font on for size.</h2>
        <div class="card-grid features-grid">
          {features.map((f, i) => (
            <article class="glass-card feature-card" data-animate-child>
              <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="how-it-works" class="section how" data-animate>
      <div class="wrap">
        <p class="eyebrow">How it works</p>
        <h2>From click to new font in seconds.</h2>
        <div class="how-layout">
          <ol class="how-steps">
            {steps.map((s, i) => (
              <li class="glass-card step-card" data-animate-child>
                <span class="step-num">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="demo-panel video-panel glass-card" data-animate-child>
            <iframe
              class="demo-video"
              src="https://www.youtube.com/embed/cFxZ6x6ZIHA"
              title="LiveFonty walkthrough"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="section suggest" data-animate>
      <div class="wrap">
        <p class="eyebrow">Roadmap</p>
        <h2>Got a suggestion for LiveFonty?</h2>
        <p class="lead center">We're actively building. Tell us what would make this more useful for you.</p>
        <div class="suggest-panel glass-card" data-animate-child>
          <form
            name="feature-suggestions"
            method="POST"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            id="suggest-form"
          >
            <input type="hidden" name="form-name" value="feature-suggestions" />
            <p class="hp-field">
              <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>
            <div class="field-row">
              <label for="name">Name <span class="optional">(optional)</span></label>
              <input id="name" name="name" type="text" autocomplete="name" />
            </div>
            <div class="field-row">
              <label for="email">Email <span class="optional">(optional)</span></label>
              <input id="email" name="email" type="email" autocomplete="email" />
            </div>
            <div class="field-row">
              <label for="suggestion">Your suggestion</label>
              <textarea id="suggestion" name="suggestion" rows="4" required></textarea>
            </div>
            <button type="submit" class="cta-primary">Send suggestion</button>
            <p class="form-error" hidden>Something went wrong — try emailing us instead.</p>
          </form>
          <div class="suggest-success" hidden>
            <p>Thanks — we read every suggestion.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="section faq" data-animate>
      <div class="wrap">
        <p class="eyebrow">FAQ</p>
        <h2>Questions, answered.</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item glass-card" data-animate-child>
              <summary>
                <span>{f.q}</span>
                <span class="chevron" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="github" class="section github" data-animate>
      <div class="wrap">
        <div class="github-panel glass-card" data-animate-child>
          <p class="eyebrow">GitHub</p>
          <h2>Liked LiveFonty? Give it a star on GitHub.</h2>
          <p class="lead center">Stars help more people find the project — and they mean a lot.</p>
          <a
            class="cta-github"
            href="https://github.com/abdalla980/LiveFonty"
            target="_blank"
            rel="noopener"
            data-ga="github_star"
            data-ga-place="section"
          >
            Star on GitHub
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById('suggest-form');
    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const errorEl = form.querySelector('.form-error');
        const successEl = document.querySelector('.suggest-success');
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
        errorEl?.setAttribute('hidden', '');

        try {
          const body = new URLSearchParams(new FormData(form)).toString();
          const res = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body,
          });
          if (!res.ok) throw new Error('Request failed');
          form.hidden = true;
          successEl?.removeAttribute('hidden');
          if (typeof gtag === 'function') {
            gtag('event', 'generate_lead', {
              event_category: 'engagement',
              event_label: 'feature_suggestion',
            });
          }
        } catch {
          errorEl?.removeAttribute('hidden');
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        }
      });
    }
  </script>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const samples = [
      { name: 'Playfair Display', text: 'Fonts, tested in place.', weight: '500' },
      { name: 'Space Grotesk', text: 'See the page. Change the font.', weight: '400' },
      { name: 'Cormorant Garamond', text: 'Commit after you feel it.', weight: '500' },
      { name: 'Syne', text: '1,900+ fonts. One click.', weight: '600' },
    ];

    if (!reduced) {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.from('.hero-anim', {
        opacity: 0,
        y: 32,
        filter: 'blur(6px)',
        duration: 0.9,
        stagger: 0.11,
      }).from('.hero-sheen', {
        opacity: 0,
        duration: 1.2,
      }, '-=0.6');

      gsap.to('.hero-sheen', {
        backgroundPosition: '120% 40%',
        duration: 8,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
      });

      gsap.to('.marquee-track', {
        xPercent: -50,
        duration: 28,
        ease: 'none',
        repeat: -1,
      });

      const nameEl = document.getElementById('lab-font-name');
      const sampleEl = document.getElementById('lab-sample');
      let sampleIndex = 0;

      const cycleLab = () => {
        sampleIndex = (sampleIndex + 1) % samples.length;
        const next = samples[sampleIndex];
        const swap = gsap.timeline();
        swap
          .to([nameEl, sampleEl], { opacity: 0, y: -8, duration: 0.35, ease: 'power2.in' })
          .add(() => {
            if (nameEl) nameEl.textContent = next.name;
            if (sampleEl) {
              sampleEl.textContent = next.text;
              sampleEl.style.fontWeight = next.weight;
            }
          })
          .to([nameEl, sampleEl], { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' });
      };

      gsap.delayedCall(2.8, () => {
        cycleLab();
        gsap.delayedCall(3.2, function loop() {
          cycleLab();
          gsap.delayedCall(3.2, loop);
        });
      });

      document.querySelectorAll('.glass-card').forEach((card) => {
        card.addEventListener('mouseenter', () => {
          gsap.to(card, { y: -6, duration: 0.35, ease: 'power2.out' });
        });
        card.addEventListener('mouseleave', () => {
          gsap.to(card, { y: 0, duration: 0.4, ease: 'power2.out' });
        });
      });

      document.querySelectorAll('[data-animate]').forEach((section) => {
        const kids = section.querySelectorAll('[data-animate-child]');
        const targets = kids.length ? kids : [section];

        gsap.from(targets, {
          opacity: 0,
          y: 40,
          duration: 0.75,
          stagger: 0.1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 80%',
            once: true,
          },
        });
      });
    } else {
      const nameEl = document.getElementById('lab-font-name');
      const sampleEl = document.getElementById('lab-sample');
      if (nameEl) nameEl.textContent = samples[0].name;
      if (sampleEl) sampleEl.textContent = samples[0].text;
    }
  </script>

  <style>
    .hero {
      position: relative;
      padding: 48px 0 0;
      overflow: hidden;
      min-height: min(92vh, 860px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .hero-sheen {
      pointer-events: none;
      position: absolute;
      inset: -20% -10%;
      background: linear-gradient(
        105deg,
        transparent 30%,
        rgba(255, 255, 255, 0.55) 48%,
        rgba(197, 202, 211, 0.25) 52%,
        transparent 70%
      );
      background-size: 200% 100%;
      background-position: 0% 40%;
      opacity: 0.7;
    }

    .hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      align-items: center;
      padding-bottom: 36px;
    }

    .brand-hero {
      font-size: clamp(42px, 7vw, 72px);
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.05em;
      margin: 0 0 16px;
      color: var(--ink);
    }

    .hero h1 {
      font-size: clamp(22px, 2.8vw, 30px);
      font-weight: 400;
      line-height: 1.35;
      max-width: 420px;
      margin: 0 0 14px;
      color: var(--ink);
    }

    .lead {
      font-size: 15px;
      line-height: 1.7;
      font-weight: 300;
      color: var(--ink-soft);
      max-width: 400px;
      margin: 0;
    }

    .lead.center {
      margin: 0 auto 28px;
      text-align: center;
      max-width: 480px;
    }

    .cta-row { margin-top: 28px; }

    .hero-lab {
      border-radius: 22px;
      overflow: hidden;
      background: linear-gradient(160deg, rgba(255,255,255,0.78), rgba(238,240,244,0.55));
      border: 1px solid rgba(255,255,255,0.8);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.9) inset,
        0 24px 50px rgba(42, 47, 58, 0.1);
      backdrop-filter: blur(18px);
    }

    .lab-chrome {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      background: rgba(255,255,255,0.35);
    }

    .lab-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--silver-3);
    }
    .lab-dot:nth-child(1) { background: #e8a0a0; }
    .lab-dot:nth-child(2) { background: #e0c97a; }
    .lab-dot:nth-child(3) { background: #9ec7a8; }

    .lab-title {
      margin-left: auto;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }

    .lab-stage {
      padding: 36px 28px 32px;
      min-height: 260px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 14px;
      background:
        radial-gradient(circle at 80% 20%, rgba(74, 53, 104, 0.08), transparent 45%),
        radial-gradient(circle at 10% 90%, rgba(196, 160, 53, 0.12), transparent 40%);
    }

    .lab-label {
      margin: 0;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--plum);
    }

    .lab-sample {
      margin: 0;
      font-size: clamp(28px, 3.4vw, 40px);
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.035em;
      color: var(--ink);
    }

    .lab-bar {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }

    .lab-pill {
      font-size: 11px;
      font-weight: 400;
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(255,255,255,0.65);
      border: 1px solid var(--border);
      color: var(--ink-soft);
    }

    .marquee {
      position: relative;
      z-index: 1;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: rgba(255,255,255,0.28);
      overflow: hidden;
      mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }

    .marquee-track {
      display: flex;
      gap: 40px;
      width: max-content;
      padding: 16px 0;
      will-change: transform;
    }

    .marquee-track span {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.04em;
      color: var(--ink-soft);
      white-space: nowrap;
    }

    .section {
      padding: 88px 0;
    }

    .section h2 {
      font-size: clamp(26px, 3.4vw, 34px);
      font-weight: 500;
      margin: 0 0 36px;
      max-width: 520px;
    }

    .audience .eyebrow,
    #features .eyebrow,
    .suggest .eyebrow {
      text-align: center;
    }

    .audience h2,
    #features h2,
    .suggest h2 {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    .glass-card {
      background: linear-gradient(155deg, rgba(255,255,255,0.72), rgba(238,240,244,0.42));
      border: 1px solid rgba(255,255,255,0.78);
      border-radius: var(--radius);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.85) inset,
        0 12px 32px rgba(42, 47, 58, 0.07);
      backdrop-filter: blur(14px);
      padding: 28px 24px;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .glass-card h3 {
      font-size: 18px;
      font-weight: 500;
      margin: 0 0 10px;
    }

    .glass-card p {
      margin: 0;
      font-size: 14px;
      line-height: 1.65;
      font-weight: 300;
      color: var(--ink-soft);
    }

    .feature-card {
      min-height: 200px;
      display: flex;
      flex-direction: column;
    }

    .card-index {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.08em;
      color: var(--mustard);
      margin-bottom: 18px;
    }

    .how-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
      align-items: start;
    }

    .how-steps {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .step-card {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding: 20px 22px;
    }

    .step-num {
      flex: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 500;
      background: var(--ink);
      color: #f5f6f8;
    }

    .demo-panel {
      min-height: 280px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 12px;
      padding: 40px 32px;
      background:
        linear-gradient(150deg, rgba(74, 53, 104, 0.92), rgba(58, 45, 82, 0.95)),
        var(--plum);
      border-color: rgba(255,255,255,0.12);
      box-shadow: 0 20px 48px rgba(74, 53, 104, 0.28);
    }

    .video-panel {
      padding: 10px;
      overflow: hidden;
      background: linear-gradient(155deg, rgba(255,255,255,0.72), rgba(238,240,244,0.5));
      border-color: rgba(255,255,255,0.78);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.85) inset,
        0 12px 32px rgba(42, 47, 58, 0.1);
    }

    .demo-video {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      border: 0;
      border-radius: 12px;
      background: #2a2f3a;
    }

    .demo-label {
      margin: 0;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--lemon);
    }

    .demo-sample {
      margin: 0;
      font-size: clamp(26px, 3.4vw, 36px);
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.03em;
      color: #fff8ea;
    }

    .demo-meta {
      margin: 6px 0 0;
      font-size: 13px;
      font-weight: 300;
      color: rgba(245, 236, 208, 0.7);
    }

    .suggest { text-align: center; }

    .suggest-panel {
      max-width: 500px;
      margin: 0 auto;
      text-align: left;
    }

    .hp-field {
      position: absolute;
      left: -9999px;
    }

    .field-row { margin-bottom: 16px; }

    .field-row label {
      display: block;
      font-size: 13px;
      font-weight: 400;
      margin-bottom: 6px;
      color: var(--ink);
    }

    .field-row .optional {
      font-weight: 300;
      color: var(--ink-soft);
    }

    .field-row input,
    .field-row textarea {
      width: 100%;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid var(--border);
      font-family: inherit;
      font-size: 14px;
      font-weight: 300;
      color: var(--ink);
      background: rgba(255,255,255,0.7);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .field-row input:focus,
    .field-row textarea:focus {
      outline: none;
      border-color: var(--plum);
      box-shadow: 0 0 0 3px rgba(74, 53, 104, 0.15);
    }

    .field-row textarea { resize: vertical; }
    #suggest-form .cta-primary { width: 100%; border-radius: 12px; }

    .form-error {
      color: #8b2e4b;
      font-size: 13px;
      margin: 12px 0 0;
    }

    .suggest-success {
      text-align: center;
      padding: 12px;
      font-weight: 400;
      color: var(--ink);
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 720px;
    }

    .faq-item {
      padding: 4px 20px 14px;
    }

    .faq-item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
