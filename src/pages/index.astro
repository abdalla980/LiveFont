---
import Layout from '../layouts/Layout.astro';

const storeUrl = 'https://chromewebstore.google.com/detail/ahdfmlobklcldcjfapjpnhdmdncdenhj?utm_source=item-share-cb';

const features = [
  {
    emoji: '🔎',
    title: 'Search All Fonts',
    body: 'Type to filter the entire Google Fonts catalog, 1,900+ families, and apply any of them to the page you’re viewing in one click.',
  },
  {
    emoji: '🎨',
    title: 'Brand Vibe Picker',
    body: 'Pick a personality — Modern & Minimal, Bold & Edgy, Elegant & Luxury, and more — and get a curated shortlist of fonts that fit it.',
  },
  {
    emoji: '📈',
    title: 'Top 10, Real Data',
    body: 'A quick-pick list of the 10 most popular fonts, ranked straight from Google Fonts’ own popularity data.',
  },
];

const audience = [
  {
    title: 'Designers',
    body: 'Pressure-test brand typography against real content before it ships to production.',
  },
  {
    title: 'Frontend Developers',
    body: 'Try font pairings on the live page instead of editing CSS and reloading, over and over.',
  },
  {
    title: 'Creative Artists',
    body: 'See how type shapes the mood and voice of a page before committing to a direction.',
  },
];

const steps = [
  {
    title: 'Open the popup',
    body: "Click the LiveFonty icon on any page you're viewing.",
  },
  {
    title: 'Search or pick a vibe',
    body: 'Filter 1,900+ fonts, browse by brand personality, or grab a Top 10 pick.',
  },
  {
    title: 'See it instantly',
    body: 'The page updates live in your browser — nothing saved, nothing sent anywhere.',
  },
];

const faqs = [
  {
    q: 'Is LiveFonty free?',
    a: 'Yes. LiveFonty is completely free to install and use, with no signup required.',
  },
  {
    q: 'Does it change my actual website, or just what I see?',
    a: "Only what you see. LiveFonty applies fonts entirely in your browser — it never touches a site's code, files, or database.",
  },
  {
    q: 'Which fonts can I use?',
    a: 'The full Google Fonts catalog — 1,900+ families — searchable, plus a curated Top 10 and picks by brand vibe.',
  },
  {
    q: 'Does LiveFonty collect any of my data?',
    a: 'No. LiveFonty has no analytics, tracking, or data collection of any kind. See the full privacy policy for details.',
  },
  {
    q: 'Which browsers are supported?',
    a: 'Chrome today, via the Chrome Web Store. Support for other Chromium-based browsers may follow.',
  },
  {
    q: 'Who is LiveFonty for?',
    a: 'Designers, frontend developers, and anyone making creative or branding decisions who wants to test typography in seconds.',
  },
];
---
<Layout title="LiveFonty — Live-preview Google Fonts on any website" description="Instantly preview any Google Font on the page you're viewing. Search 1,900+ fonts, browse by brand vibe, or pick from a real-data Top 10.">
  <main>
    <section class="band band-white">
      <div class="wrap hero">
        <div class="pill">Chrome Extension</div>
        <h1>See your site in a different font before you commit to it.</h1>
        <p class="lead">
          LiveFonty previews any Google Font on the webpage you're currently viewing &mdash;
          instantly, with no code changes. Search the full catalog, browse by brand vibe,
          or grab one of the real-data Top 10.
        </p>
        <div class="cta-row">
          <a class="cta-primary" href={storeUrl} target="_blank" rel="noopener">Download for Chrome</a>
        </div>
      </div>
    </section>

    <section class="band band-black reveal">
      <div class="wrap audience">
        <p class="eyebrow">Who it's for</p>
        <h2>Built for people who obsess over type.</h2>
        <div class="audience-grid">
          {audience.map((a) => (
            <div class="audience-item">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="features" class="band band-white reveal">
      <div class="wrap">
        <p class="eyebrow">Features</p>
        <h2>Everything you need to try a font on for size.</h2>
        <div class="cards">
          {features.map((f) => (
            <div class="card">
              <div class="card-icon">{f.emoji}</div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="how-it-works" class="band band-black reveal">
      <div class="wrap how">
        <p class="eyebrow">How it works</p>
        <h2>From click to new font in seconds.</h2>
        <div class="how-layout">
          <ol class="how-steps">
            {steps.map((s, i) => (
              <li>
                <span class="step-num">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="video-frame">
            <div class="video-poster">
              <span class="play-icon-wrap">
                <span class="play-icon"></span>
              </span>
            </div>
            <p class="video-caption">Full walkthrough video — coming soon</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band band-white reveal">
      <div class="wrap suggest">
        <p class="eyebrow">Roadmap</p>
        <h2>Got an idea for LiveFonty?</h2>
        <p class="lead">We're actively building. Tell us what would make this more useful for you.</p>
        <div class="suggest-panel">
          <form
            name="feature-suggestions"
            method="POST"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            id="suggest-form"
          >
            <input type="hidden" name="form-name" value="feature-suggestions" />
            <p class="hp-field">
              <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>
            <div class="field-row">
              <label for="name">Name <span class="optional">(optional)</span></label>
              <input id="name" name="name" type="text" autocomplete="name" />
            </div>
            <div class="field-row">
              <label for="email">Email <span class="optional">(optional)</span></label>
              <input id="email" name="email" type="email" autocomplete="email" />
            </div>
            <div class="field-row">
              <label for="suggestion">Your idea</label>
              <textarea id="suggestion" name="suggestion" rows="4" required></textarea>
            </div>
            <button type="submit" class="cta-primary">Send suggestion</button>
            <p class="form-error" hidden>Something went wrong — try emailing us instead.</p>
          </form>
          <div class="suggest-success" hidden>
            <p>Thanks — we read every suggestion.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="band band-black reveal">
      <div class="wrap faq">
        <p class="eyebrow">FAQ</p>
        <h2>Questions, answered.</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>
                <span>{f.q}</span>
                <span class="chevron" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="download" class="band band-white reveal">
      <div class="wrap cta-bottom">
        <h2>See it on your own site.</h2>
        <p>Free, instant, no code changes.</p>
        <a class="cta-primary" href={storeUrl} target="_blank" rel="noopener">Download for Chrome</a>
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById('suggest-form');
    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const errorEl = form.querySelector('.form-error');
        const successEl = document.querySelector('.suggest-success');
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
        errorEl?.setAttribute('hidden', '');

        try {
          const body = new URLSearchParams(new FormData(form)).toString();
          const res = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body,
          });
          if (!res.ok) throw new Error('Request failed');
          form.hidden = true;
          successEl?.removeAttribute('hidden');
        } catch (err) {
          errorEl?.removeAttribute('hidden');
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        }
      });
    }
  </script>

  <style>
    .band {
      padding: 0;
    }
    .band-white {
      background: #ffffff;
      color: var(--ink);
    }
    .band-black {
      background: var(--ink);
      color: var(--night-text);
    }
    .band-black h2 {
      color: #ffffff;
    }
    .band-black .lead,
    .band-black p {
      color: var(--night-muted);
    }
    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 12px;
      font-weight: 700;
      color: var(--red);
      margin: 0 0 10px;
    }
    .band-black .eyebrow {
      color: var(--red-bright);
    }

    /* Hero */
    .hero {
      padding-top: 72px;
      padding-bottom: 48px;
      text-align: center;
    }
    .pill {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 999px;
      background: var(--ink);
      color: #fff;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.02em;
      margin-bottom: 20px;
    }
    h1 {
      font-weight: 800;
      font-size: 40px;
      line-height: 1.2;
      margin: 0 0 20px;
      letter-spacing: -0.02em;
      max-width: 680px;
      margin-left: auto;
      margin-right: auto;
    }
    .lead {
      font-size: 17px;
      line-height: 1.6;
      color: var(--muted);
      max-width: 560px;
      margin: 0 auto;
    }
    .hero .cta-row {
      margin-top: 32px;
    }
    .cta-primary {
      display: inline-block;
      padding: 12px 24px;
      border-radius: 8px;
      background: var(--ink);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      transition: opacity 0.15s ease, transform 0.15s ease;
      border: none;
      cursor: pointer;
    }
    .cta-primary:hover {
      opacity: 0.85;
      transform: translateY(-1px);
    }

    /* Who it's for */
    .audience {
      padding-top: 72px;
      padding-bottom: 72px;
      text-align: center;
    }
    .audience h2 {
      font-size: 30px;
      letter-spacing: -0.02em;
      margin: 0 0 40px;
    }
    .audience-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      text-align: left;
    }
    .audience-item {
      border: 1px solid var(--night-border);
      border-radius: 14px;
      padding: 24px;
    }
    .audience-item h3 {
      font-size: 16px;
      margin: 0 0 8px;
      color: #fff;
    }
    .audience-item p {
      font-size: 14px;
      line-height: 1.6;
      margin: 0;
    }

    /* Features */
    #features {
      padding: 72px 0;
    }
    #features h2 {
      font-size: 30px;
      letter-spacing: -0.02em;
      margin: 0 0 40px;
      text-align: center;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .card {
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 28px 24px;
      background: #fff;
      box-shadow: 0 1px 2px rgba(0,0,0,0.03);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.08);
      border-color: var(--red);
    }
    .card-icon {
      font-size: 28px;
      margin-bottom: 14px;
    }
    .card h3 {
      font-size: 17px;
      margin: 0 0 8px;
      letter-spacing: -0.01em;
    }
    .card p {
      font-size: 14px;
      line-height: 1.6;
      color: var(--muted);
      margin: 0;
    }

    /* How it works */
    .how {
      padding-top: 72px;
      padding-bottom: 72px;
    }
    .how h2 {
      font-size: 30px;
      letter-spacing: -0.02em;
      margin: 0 0 40px;
    }
    .how-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
    }
    .how-steps {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .how-steps li {
      display: flex;
      gap: 16px;
    }
    .step-num {
      flex: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1px solid var(--red-bright);
      color: var(--red-bright);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
    }
    .how-steps h3 {
      font-size: 16px;
      margin: 0 0 4px;
      color: #fff;
    }
    .how-steps p {
      font-size: 14px;
      line-height: 1.6;
      margin: 0;
    }
    .video-frame {
      position: sticky;
      top: 24px;
    }
    .video-poster {
      aspect-ratio: 16 / 9;
      background: linear-gradient(135deg, #1a1a1a, #000);
      border: 1px solid var(--night-border);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .play-icon-wrap {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      border: 2px solid var(--red-bright);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }
    .video-frame:hover .play-icon-wrap {
      transform: scale(1.08);
    }
    .play-icon {
      width: 0;
      height: 0;
      border-top: 12px solid transparent;
      border-bottom: 12px solid transparent;
      border-left: 20px solid var(--red-bright);
      margin-left: 6px;
    }
    .video-caption {
      text-align: center;
      font-size: 13px;
      margin: 12px 0 0;
    }

    /* Suggest */
    .suggest {
      padding-top: 72px;
      padding-bottom: 72px;
      text-align: center;
    }
    .suggest h2 {
      font-size: 30px;
      letter-spacing: -0.02em;
      margin: 0 0 12px;
    }
    .suggest .lead {
      margin-bottom: 32px;
    }
    .suggest-panel {
      max-width: 480px;
      margin: 0 auto;
      text-align: left;
    }
    .hp-field {
      position: absolute;
      left: -9999px;
    }
    .field-row {
      margin-bottom: 16px;
    }
    .field-row label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
    }
    .field-row .optional {
      font-weight: 400;
      color: var(--muted);
    }
    .field-row input,
    .field-row textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font-family: inherit;
      font-size: 14px;
      color: var(--ink);
      background: #fff;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .field-row input:focus,
    .field-row textarea:focus {
      outline: none;
      border-color: var(--red);
      box-shadow: 0 0 0 3px rgba(126,12,12,0.12);
    }
    .field-row textarea {
      resize: vertical;
    }
    #suggest-form .cta-primary {
      width: 100%;
      text-align: center;
    }
    .form-error {
      color: var(--red);
      font-size: 13px;
      margin: 12px 0 0;
    }
    .suggest-success {
      max-width: 480px;
      margin: 0 auto;
      text-align: center;
      padding: 24px;
      border: 1px solid var(--border);
      border-radius: 12px;
      font-weight: 600;
    }

    /* FAQ */
    .faq {
      padding-top: 72px;
      padding-bottom: 72px;
    }
    .faq h2 {
      font-size: 30px;
      letter-spacing: -0.02em;
      margin: 0 0 40px;
    }
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .faq-item {
      border: 1px solid var(--night-border);
      border-radius: 12px;
      padding: 18px 20px;
    }
    .faq-item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      cursor: pointer;
      font-weight: 600;
      color: #fff;
      list-style: none;
    }
    .faq-item summary::-webkit-details-marker {
      display: none;
    }
    .faq-item summary:hover {
      color: var(--red-bright);
    }
    .faq-item .chevron {
      flex: none;
      width: 10px;
      height: 10px;
      border-right: 2px solid var(--red-bright);
      border-bottom: 2px solid var(--red-bright);
      transform: rotate(45deg);
      transition: transform 0.2s ease;
    }
    .faq-item[open] .chevron {
      transform: rotate(-135deg);
    }
    .faq-item p {
      margin: 14px 0 0;
      font-size: 14px;
      line-height: 1.6;
    }

    /* Bottom CTA */
    .cta-bottom {
      text-align: center;
      padding-top: 56px;
      padding-bottom: 88px;
    }
    .cta-bottom h2 {
      font-weight: 800;
      font-size: 28px;
      letter-spacing: -0.02em;
      margin: 0 0 8px;
    }
    .cta-bottom p {
      color: var(--muted);
      font-size: 15px;
      margin: 0 0 28px;
    }

    @media (max-width: 720px) {
      h1 { font-size: 30px; }
      .cards { grid-template-columns: 1fr; }
      .audience-grid { grid-template-columns: 1fr; }
      .how-layout { grid-template-columns: 1fr; }
      .video-frame { position: static; }
    }
  </style>
</Layout>
