---
import Layout from '../layouts/Layout.astro';

const storeUrl = 'https://chromewebstore.google.com/detail/ahdfmlobklcldcjfapjpnhdmdncdenhj?utm_source=item-share-cb';

const features = [
  {
    title: 'Search all fonts',
    body: 'Type to filter the entire Google Fonts catalog — 1,900+ families — and apply any of them to the page you’re viewing in one click.',
  },
  {
    title: 'Brand vibe picker',
    body: 'Pick a personality — Modern & Minimal, Bold & Edgy, Elegant & Luxury, and more — and get a curated shortlist that fits.',
  },
  {
    title: 'Top 10, real data',
    body: 'A quick-pick list of the 10 most popular fonts, ranked from Google Fonts’ own popularity data.',
  },
];

const audience = [
  {
    title: 'Designers',
    body: 'Pressure-test brand typography against real content before it ships.',
  },
  {
    title: 'Frontend developers',
    body: 'Try pairings on the live page instead of editing CSS and reloading.',
  },
  {
    title: 'Creative artists',
    body: 'See how type shapes mood and voice before committing to a direction.',
  },
];

const steps = [
  {
    title: 'Open the popup',
    body: "Click the LiveFonty icon on any page you're viewing.",
  },
  {
    title: 'Search or pick a vibe',
    body: 'Filter 1,900+ fonts, browse by brand personality, or grab a Top 10 pick.',
  },
  {
    title: 'See it instantly',
    body: 'The page updates live in your browser — nothing saved, nothing sent anywhere.',
  },
];

const faqs = [
  {
    q: 'Is LiveFonty free?',
    a: 'Yes. LiveFonty is completely free to install and use, with no signup required.',
  },
  {
    q: 'Does it change my actual website, or just what I see?',
    a: "Only what you see. LiveFonty applies fonts entirely in your browser — it never touches a site's code, files, or database.",
  },
  {
    q: 'Which fonts can I use?',
    a: 'The full Google Fonts catalog — 1,900+ families — searchable, plus a curated Top 10 and picks by brand vibe.',
  },
  {
    q: 'Does LiveFonty collect any of my data?',
    a: 'No. LiveFonty has no analytics, tracking, or data collection of any kind. See the full privacy policy for details.',
  },
  {
    q: 'Which browsers are supported?',
    a: 'Chrome today, via the Chrome Web Store. Support for other Chromium-based browsers may follow.',
  },
  {
    q: 'Who is LiveFonty for?',
    a: 'Designers, frontend developers, and anyone making creative or branding decisions who wants to test typography in seconds.',
  },
];
---
<Layout title="LiveFonty — Live-preview Google Fonts on any website" description="Instantly preview any Google Font on the page you're viewing. Search 1,900+ fonts, browse by brand vibe, or pick from a real-data Top 10.">
  <main>
    <section class="hero">
      <div class="wrap hero-inner">
        <p class="eyebrow hero-anim">Chrome extension</p>
        <p class="brand-hero hero-anim">LiveFonty</p>
        <h1 class="hero-anim">See your site in a different font before you commit.</h1>
        <p class="lead hero-anim">
          Preview any Google Font on the page you're viewing — instantly, with no code changes.
        </p>
        <div class="cta-row hero-anim">
          <a class="cta-primary" href={storeUrl} target="_blank" rel="noopener">Download for Chrome</a>
        </div>
        <div class="specimen hero-anim" aria-hidden="true">
          <span class="specimen-aa">Aa</span>
          <span class="specimen-line">The quick brown fox</span>
        </div>
      </div>
    </section>

    <section class="section audience" data-animate>
      <div class="wrap">
        <p class="eyebrow">Who it's for</p>
        <h2>Built for people who obsess over type.</h2>
        <div class="audience-grid">
          {audience.map((a) => (
            <div class="audience-item" data-animate-child>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="features" class="section" data-animate>
      <div class="wrap">
        <p class="eyebrow">Features</p>
        <h2>Everything you need to try a font on for size.</h2>
        <div class="feature-list">
          {features.map((f, i) => (
            <div class="feature-row" data-animate-child>
              <span class="feature-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="how-it-works" class="section how" data-animate>
      <div class="wrap">
        <p class="eyebrow">How it works</p>
        <h2>From click to new font in seconds.</h2>
        <div class="how-layout">
          <ol class="how-steps">
            {steps.map((s, i) => (
              <li data-animate-child>
                <span class="step-num">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="demo-panel" data-animate-child>
            <p class="demo-label">Live preview</p>
            <p class="demo-sample">Typography, tested in place.</p>
            <p class="demo-meta">Full walkthrough video — coming soon</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section suggest" data-animate>
      <div class="wrap">
        <p class="eyebrow">Roadmap</p>
        <h2>Got an idea for LiveFonty?</h2>
        <p class="lead">We're actively building. Tell us what would make this more useful for you.</p>
        <div class="suggest-panel">
          <form
            name="feature-suggestions"
            method="POST"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            id="suggest-form"
          >
            <input type="hidden" name="form-name" value="feature-suggestions" />
            <p class="hp-field">
              <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>
            <div class="field-row">
              <label for="name">Name <span class="optional">(optional)</span></label>
              <input id="name" name="name" type="text" autocomplete="name" />
            </div>
            <div class="field-row">
              <label for="email">Email <span class="optional">(optional)</span></label>
              <input id="email" name="email" type="email" autocomplete="email" />
            </div>
            <div class="field-row">
              <label for="suggestion">Your idea</label>
              <textarea id="suggestion" name="suggestion" rows="4" required></textarea>
            </div>
            <button type="submit" class="cta-primary">Send suggestion</button>
            <p class="form-error" hidden>Something went wrong — try emailing us instead.</p>
          </form>
          <div class="suggest-success" hidden>
            <p>Thanks — we read every suggestion.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="section faq" data-animate>
      <div class="wrap">
        <p class="eyebrow">FAQ</p>
        <h2>Questions, answered.</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item" data-animate-child>
              <summary>
                <span>{f.q}</span>
                <span class="chevron" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="download" class="section cta-bottom" data-animate>
      <div class="wrap">
        <h2>See it on your own site.</h2>
        <p>Free, instant, no code changes.</p>
        <a class="cta-primary" href={storeUrl} target="_blank" rel="noopener">Download for Chrome</a>
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById('suggest-form');
    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const errorEl = form.querySelector('.form-error');
        const successEl = document.querySelector('.suggest-success');
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
        errorEl?.setAttribute('hidden', '');

        try {
          const body = new URLSearchParams(new FormData(form)).toString();
          const res = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body,
          });
          if (!res.ok) throw new Error('Request failed');
          form.hidden = true;
          successEl?.removeAttribute('hidden');
        } catch {
          errorEl?.removeAttribute('hidden');
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        }
      });
    }
  </script>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      gsap.from('.hero-anim', {
        opacity: 0,
        y: 28,
        duration: 0.85,
        stagger: 0.12,
        ease: 'power3.out',
        delay: 0.08,
      });

      gsap.to('.specimen-aa', {
        y: -10,
        duration: 3.2,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
      });

      document.querySelectorAll('[data-animate]').forEach((section) => {
        const kids = section.querySelectorAll('[data-animate-child]');
        const targets = kids.length ? kids : [section.querySelector('.wrap') ?? section];

        gsap.from(targets, {
          opacity: 0,
          y: 36,
          duration: 0.7,
          stagger: 0.1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 78%',
            once: true,
          },
        });
      });
    }
  </script>

  <style>
    .hero {
      padding: 56px 0 28px;
      min-height: min(88vh, 820px);
      display: flex;
      align-items: center;
    }
    .hero-inner {
      text-align: center;
      position: relative;
      padding-bottom: 48px;
    }
    .brand-hero {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(48px, 10vw, 88px);
      line-height: 0.95;
      letter-spacing: -0.045em;
      margin: 0 0 18px;
      color: var(--plum);
      background: linear-gradient(120deg, var(--plum) 20%, #6b4c9a 55%, var(--mustard) 110%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    h1 {
      font-size: clamp(26px, 4.2vw, 38px);
      line-height: 1.2;
      font-weight: 700;
      max-width: 620px;
      margin: 0 auto 16px;
      color: var(--plum);
    }
    .lead {
      font-size: 16px;
      line-height: 1.65;
      color: var(--plum-soft);
      max-width: 480px;
      margin: 0 auto;
    }
    .cta-row {
      margin-top: 28px;
    }
    .specimen {
      margin-top: 48px;
      padding: 36px 24px 40px;
      border-radius: 18px;
      background:
        linear-gradient(145deg, color-mix(in srgb, var(--lilac-deep) 70%, white), color-mix(in srgb, var(--cream) 80%, white));
      border: 1px solid var(--border);
      display: grid;
      gap: 8px;
      justify-items: center;
    }
    .specimen-aa {
      font-family: var(--font-display);
      font-size: clamp(72px, 16vw, 120px);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.06em;
      color: var(--plum);
      display: block;
    }
    .specimen-line {
      font-family: var(--font-display);
      font-size: clamp(18px, 3vw, 28px);
      font-weight: 500;
      color: var(--mustard);
      letter-spacing: -0.02em;
    }

    .section {
      padding: 88px 0;
    }
    .section h2 {
      font-size: clamp(26px, 3.5vw, 34px);
      margin: 0 0 36px;
      max-width: 520px;
    }
    .audience h2,
    .suggest h2,
    .cta-bottom h2,
    #features h2,
    .how h2,
    .faq h2 {
      text-align: left;
    }
    .audience .wrap > h2,
    #features .wrap > h2,
    .suggest .wrap > h2,
    .cta-bottom .wrap > h2 {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }
    .audience .eyebrow,
    #features .eyebrow,
    .suggest .eyebrow,
    .cta-bottom .eyebrow {
      text-align: center;
    }

    .audience-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px 32px;
    }
    .audience-item h3 {
      font-size: 20px;
      margin: 0 0 8px;
    }
    .audience-item p {
      margin: 0;
      font-size: 14px;
      line-height: 1.65;
      color: var(--plum-soft);
    }

    .feature-list {
      display: flex;
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--border);
    }
    .feature-row {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 20px;
      padding: 28px 0;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }
    .feature-num {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 700;
      color: var(--mustard);
      line-height: 1;
    }
    .feature-row h3 {
      font-size: 20px;
      margin: 0 0 8px;
    }
    .feature-row p {
      margin: 0;
      font-size: 14px;
      line-height: 1.65;
      color: var(--plum-soft);
      max-width: 520px;
    }

    .how-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: start;
    }
    .how-steps {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .how-steps li {
      display: flex;
      gap: 16px;
    }
    .step-num {
      flex: none;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--plum);
      color: var(--lemon);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
    }
    .how-steps h3 {
      font-size: 18px;
      margin: 0 0 6px;
    }
    .how-steps p {
      margin: 0;
      font-size: 14px;
      line-height: 1.65;
      color: var(--plum-soft);
    }
    .demo-panel {
      border-radius: 16px;
      padding: 40px 28px;
      background: linear-gradient(150deg, var(--plum) 0%, #4a2d72 55%, #6b4c9a 100%);
      color: var(--cream);
      min-height: 240px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 12px;
    }
    .demo-label {
      margin: 0;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--lemon);
    }
    .demo-sample {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 40px);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.03em;
      color: #fff8ea;
    }
    .demo-meta {
      margin: 8px 0 0;
      font-size: 13px;
      color: color-mix(in srgb, var(--cream) 70%, transparent);
    }

    .suggest {
      text-align: center;
    }
    .suggest .lead {
      margin-bottom: 32px;
    }
    .suggest-panel {
      max-width: 480px;
      margin: 0 auto;
      text-align: left;
    }
    .hp-field {
      position: absolute;
      left: -9999px;
    }
    .field-row {
      margin-bottom: 16px;
    }
    .field-row label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--plum);
    }
    .field-row .optional {
      font-weight: 400;
      color: var(--plum-soft);
    }
    .field-row input,
    .field-row textarea {
      width: 100%;
      padding: 12px 14px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font-family: inherit;
      font-size: 14px;
      color: var(--plum);
      background: color-mix(in srgb, white 70%, var(--lilac));
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .field-row input:focus,
    .field-row textarea:focus {
      outline: none;
      border-color: var(--mustard);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--mustard) 28%, transparent);
    }
    .field-row textarea { resize: vertical; }
    #suggest-form .cta-primary {
      width: 100%;
    }
    .form-error {
      color: #8b2e4b;
      font-size: 13px;
      margin: 12px 0 0;
    }
    .suggest-success {
      text-align: center;
      padding: 28px;
      border: 1px solid var(--border);
      border-radius: 12px;
      font-weight: 600;
      color: var(--plum);
      background: color-mix(in srgb, var(--lemon) 18%, white);
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .faq-item {
      border-bottom: 1px solid var(--border);
      padding: 4px 0 14px;
    }
    .faq-item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      cursor: pointer;
      font-weight: 600;
      font-size: 15px;
      color: var(--plum);
      list-style: none;
      padding: 12px 0;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary:hover { color: #4a2d72; }
    .faq-item .chevron {
      flex: none;
      width: 10px;
      height: 10px;
      border-right: 2px solid var(--mustard);
      border-bottom: 2px solid var(--mustard);
      transform: rotate(45deg);
      transition: transform 0.2s ease;
    }
    .faq-item[open] .chevron {
      transform: rotate(-135deg);
    }
    .faq-item p {
      margin: 0 0 8px;
      font-size: 14px;
      line-height: 1.65;
      color: var(--plum-soft);
      max-width: 640px;
    }

    .cta-bottom {
      text-align: center;
      padding-bottom: 110px;
    }
    .cta-bottom h2 {
      font-size: clamp(28px, 4vw, 36px);
      margin: 0 0 10px;
    }
    .cta-bottom p {
      color: var(--plum-soft);
      font-size: 15px;
      margin: 0 0 28px;
    }

    @media (max-width: 720px) {
      .audience-grid { grid-template-columns: 1fr; }
      .how-layout { grid-template-columns: 1fr; }
      .feature-row { grid-template-columns: 48px 1fr; gap: 14px; }
      .hero { min-height: auto; padding-top: 40px; }
      .section { padding: 64px 0; }
    }
  </style>
</Layout>
